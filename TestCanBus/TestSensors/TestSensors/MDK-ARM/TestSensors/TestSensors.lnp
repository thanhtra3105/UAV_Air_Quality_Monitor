--cpu Cortex-M3
"testsensors\startup_stm32f103xb.o"
"testsensors\am2301b.o"
"testsensors\ens160.o"
"testsensors\mcp2515.o"
"testsensors\main.o"
"testsensors\stm32f1xx_it.o"
"testsensors\stm32f1xx_hal_msp.o"
"testsensors\stm32f1xx_hal_gpio_ex.o"
"testsensors\stm32f1xx_hal_adc.o"
"testsensors\stm32f1xx_hal_adc_ex.o"
"testsensors\stm32f1xx_hal.o"
"testsensors\stm32f1xx_hal_rcc.o"
"testsensors\stm32f1xx_hal_rcc_ex.o"
"testsensors\stm32f1xx_hal_gpio.o"
"testsensors\stm32f1xx_hal_dma.o"
"testsensors\stm32f1xx_hal_cortex.o"
"testsensors\stm32f1xx_hal_pwr.o"
"testsensors\stm32f1xx_hal_flash.o"
"testsensors\stm32f1xx_hal_flash_ex.o"
"testsensors\stm32f1xx_hal_exti.o"
